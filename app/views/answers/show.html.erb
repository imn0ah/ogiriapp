<div class="answer-show">
  <h1 class="page-title">回答結果</h1>

  <div class="result-card">
    <h2>お題</h2>
    <p><%= @answer.question.content %></p>
  </div>

  <div class="result-card">
    <h2>回答</h2>
    <p><%= @answer.content %></p>
  </div>

  <div class="result-actions">
    <%= link_to "SNSに投稿",
                post_to_sns_path(@answer),
                target: "_blank",
                rel: "noopener",
                class: "result-button" %>

    <%= link_to "みんなのネタ帳に載せる",
                answers_path,
                class: "result-button" %>

    <%= link_to "別のお題へ",
                questions_path,
                class: "result-button" %>
  </div>
</div>

