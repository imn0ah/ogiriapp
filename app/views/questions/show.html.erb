<div class="question-show">
  <h1>お題</h1>

  <div class="question-card">
    <p><%= @question.content %></p>
  </div>

    <div class="answer-form">
    <%= form_with model: [@question, Answer.new] do |f| %>
      <%= f.label :content, "あなたの回答" %>

      <%= f.text_area :content,
                      placeholder: "渾身の回答をここに入力" %>

      <div class="answer-actions">
        <%= f.submit "回答する" %>
      </div>
    <% end %>

    <div class="answer-actions">
      <%= link_to "カテゴリー選択に戻る",
                  questions_path,
                  class: "question-action-link" %>

      <%= link_to "別のお題に変更",
                  questions_show_path(category: @question.category),
                  class: "question-action-link" %>
    </div>
  </div>
</div>

